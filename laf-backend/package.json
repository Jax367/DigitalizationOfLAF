{
  "name": "laf-backend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/integration.mjs",
    "db:migrate:local": "wrangler d1 migrations apply laf-database --local",
    "db:migrate:remote": "wrangler d1 migrations apply laf-database --remote",
    "deploy": "node scripts/deploy-production.mjs",
    "deploy:check": "node scripts/deploy-production.mjs --check",
    "test:security": "wrangler deploy --dry-run --outdir .test-build && node scripts/security-smoke.mjs",
    "test:applications": "wrangler deploy --dry-run --outdir .test-build && node scripts/applications-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "typescript": "^5.9.3",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "0.35.5"
  }
}
